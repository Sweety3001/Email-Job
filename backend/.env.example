# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Data stores ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Slack OAuth ────────────────────────────────────────────────────────
# Create at https://api.slack.com/apps → OAuth & Permissions → scopes: chat:write
# Redirect URLs: http://localhost:4000/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Email senders (multiple senders) ──────────────────────────────────
# Optional JSON array of Ethereal accounts. If empty, the backend
# auto-creates 2 Ethereal test accounts on first boot and logs their
# credentials + preview URLs.
# SENDERS=[{"name":"Sender One","email":"a@ethereal.email","smtpUser":"...","smtpPass":"..."}]
SENDERS=

# ── Throughput / rate limiting (all configurable) ─────────────────────
# Worker concurrency: how many emails a single worker processes in parallel
EMAIL_WORKER_CONCURRENCY=5
# Minimum delay between two consecutive email sends (ms). Acts like provider throttling.
MIN_DELAY_MS=2000
# Global hourly cap on sends (0 = unlimited)
MAX_EMAILS_PER_HOUR=200
# Per-sender hourly cap on sends (0 = unlimited)
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# "global" | "sender" — which hourly limit(s) to enforce. "sender" enforces per-sender only,
# "global" enforces the global cap only, "both" enforces both.
RATE_LIMIT_MODE=both

# ── Queue ──────────────────────────────────────────────────────────────
EMAIL_QUEUE_NAME=email-dispatch
