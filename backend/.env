# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── Data stores ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=reachinbox-demo-secret-change-me-9f8a7b6c5d4e3f2a1b0c
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
# GOOGLE_CLIENT_ID=855546788601-b09h91rv4urmesihdgg5obks5f8omkmt.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=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

# ── Slack OAuth ────────────────────────────────────────────────────────
# Create at https://api.slack.com/apps → scopes: chat:write, channels:read
# Redirect URL: http://localhost:4000/api/slack/callback
SLACK_CLIENT_ID=12031864716914.12060342779664
SLACK_CLIENT_SECRET=094b2aceead91a0ea4a1b3573195af6e

# ── Email senders ──────────────────────────────────────────────────────
# Leave empty — backend auto-creates 2 Ethereal test accounts on first boot
SENDERS=

# ── Throughput / rate limiting ─────────────────────────────────────────
EMAIL_WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=100
RATE_LIMIT_MODE=both

# ── Queue ──────────────────────────────────────────────────────────────
EMAIL_QUEUE_NAME=email-dispatch
